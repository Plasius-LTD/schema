{
  "name": "@plasius/schema",
  "version": "1.3.1",
  "description": "Entity schema definition & validation helpers for Plasius ecosystem",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "unicode"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./feedback-diagnostics": {
      "types": "./dist/feedback-diagnostics.d.ts",
      "import": "./dist/feedback-diagnostics.js",
      "require": "./dist/feedback-diagnostics.cjs"
    },
    "./feedback-diagnostics-vocabulary": {
      "types": "./dist/feedback-diagnostics-vocabulary.d.ts",
      "import": "./dist/feedback-diagnostics-vocabulary.js",
      "require": "./dist/feedback-diagnostics-vocabulary.cjs"
    },
    "./feedback-unicode-profile": {
      "types": "./dist/feedback-unicode-profile.d.ts",
      "import": "./dist/feedback-unicode-profile.js",
      "require": "./dist/feedback-unicode-profile.cjs"
    },
    "./unicode/feedback-unicode-15.1.0-unassigned.json": "./unicode/feedback-unicode-15.1.0-unassigned.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run unicode:check && tsup",
    "test": "npm run unicode:check && vitest run && npm run test:privacy",
    "test:watch": "vitest",
    "test:privacy": "node --experimental-test-coverage --test-coverage-include=scripts/private-artifact-policy.cjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=60 --test tests/private-artifact-policy.test.cjs",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm run privacy:check && node scripts/verify-public-package.cjs",
    "privacy:check": "node scripts/verify-private-artifacts.cjs",
    "unicode:check": "node scripts/generate-feedback-unicode-profile.cjs --check",
    "unicode:generate": "node scripts/generate-feedback-unicode-profile.cjs",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "schema",
    "validation",
    "data-validation",
    "schema-validation",
    "typed-schema",
    "json-schema",
    "typescript",
    "typesafe",
    "runtime-validation",
    "type-safety",
    "plasius",
    "schema-helper",
    "entity-schema",
    "domain-modeling",
    "agnostic",
    "oss",
    "frontend",
    "backend",
    "portable",
    "scalability",
    "monorepo-friendly"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/schema.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/schema/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/schema#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@unicode/unicode-15.1.0": "1.6.17",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
